# ============================================================================
# CoreRAG P6 deployment credentials.
# Copy to `.env.prod` and paste in the real values once you've created the
# accounts:  cp .env.prod.example .env.prod
# `.env.prod` is gitignored (same `.env.*` rule as local `.env`) -- never
# committed, never pasted into chat. I read from this file directly when
# running the P6.2 deployment/migration commands.
# ============================================================================

# ---- Qdrant Cloud (qdrant.tech/cloud -- free cluster) ----------------------
# From the cluster's "Connect" tab.
QDRANT_URL=
QDRANT_API_KEY=

# ---- Redis Cloud (redis.io/cloud -- free database, NOT Upstash) -----------
# The full connection string, e.g. redis://default:<password>@<host>:<port>
REDIS_URL=

# ---- Google Cloud Run (console.cloud.google.com -- free Always Free tier) -
# No token needed here: install the gcloud CLI, then run `gcloud auth login`
# yourself once in a terminal on this machine (interactive browser OAuth --
# not something I can do on your behalf). Once you're authenticated, the
# credential lives in your local gcloud config and I can run
# `gcloud run deploy` from here, same as I already use your local docker/.env.
# Must be one of the free-tier regions: us-central1, us-east1, or us-west1.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ---- Already have these (existing .env) -- passed to `gcloud run deploy`
# via --set-env-vars when I run it, not pasted here.
# GROQ_API_KEY, OPENAI_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY
