# ============================================================================
# CoreRAG environment configuration.
# Copy to `.env` and fill in the secrets:  cp .env.example .env
# `.env` is gitignored. Only the two API keys are REQUIRED; everything else has
# a sane default in core/config.py. Keep comments on their own lines (values are
# read verbatim). List-valued settings, if overridden, use JSON syntax.
# ============================================================================

# ---- Required secrets ------------------------------------------------------
# Generation LLM (Groq) -- https://console.groq.com
GROQ_API_KEY=
# Router + grader + contextualization LLM (OpenAI) -- https://platform.openai.com
OPENAI_API_KEY=

# ---- Optional / inactive ----------------------------------------------------
# Kept in case we swap the agent LLM back to OpenRouter; not currently used.
# OPENROUTER_API_KEY=

# ---- Application -----------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---- API hardening (P6.3; local dev defaults shown, tighten for prod) ------
# CORS_ALLOWED_ORIGINS=["*"]
# RATE_LIMIT_PER_MINUTE=20

# ---- Models (locked defaults; uncomment to experiment) ---------------------
# GENERATION_MODEL=llama-3.3-70b-versatile
# AGENT_MODEL=gpt-4o-mini
# DENSE_EMBED_MODEL=BAAI/bge-base-en-v1.5
# RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
# RERANKER_MODE=cpu-onnx
# RERANKER_SERVICE_URL=

# ---- Retrieval / reflection ------------------------------------------------
# RETRIEVAL_K=50
# RERANK_TOP_N=5
# MAX_REFLECTION_RETRIES=2
# GRADER_RELEVANCE_THRESHOLD=0.5

# ---- Semantic cache --------------------------------------------------------
# CACHE_ENABLED=true
# CACHE_SIMILARITY_THRESHOLD=0.95
# CACHE_TTL_SECONDS=86400
# CACHE_VERSION=v1

# ---- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=corerag
# QDRANT_COLLECTION_VERSION=v1

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- GROBID (ingestion only) -----------------------------------------------
GROBID_URL=http://localhost:8070

# ---- Langfuse (observability; Cloud free tier -- leave blank to disable) ---
# Get keys from your Langfuse Cloud project: Settings > API Keys.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Corpus / ingestion (locked; override with JSON if needed) -------------
# ARXIV_CATEGORIES=["cs.DC","cs.AR","cs.LG"]
# ARXIV_MAX_PAPERS=150
# ARXIV_DATE_FLOOR=2022-01-01
